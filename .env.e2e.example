# Playwright E2E — copy to .env.e2e and fill in (never commit .env.e2e)

E2E_ADMIN_EMAIL=gs-e2e-admin@gs-e2e-admin.com
E2E_ADMIN_PASSWORD=
E2E_ADMIN_NAME=gs-e2e-admin

E2E_PLAYER2_EMAIL=
E2E_PLAYER2_PASSWORD=
E2E_PLAYER2_NAME=

# Optional; defaults to http://127.0.0.1:5173
# E2E_BASE_URL=http://127.0.0.1:5173

# Skip auto disable/enable of the "Sync NFL Data" GitHub workflow (default: pause it)
# E2E_SKIP_WORKFLOW_PAUSE=1

# App (also loadable from .env)
# PUBLIC_SUPABASE_URL=
# PUBLIC_SUPABASE_ANON_KEY=
