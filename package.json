{
	"name": "golden-spoon",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"db:apply-admin-kick": "node scripts/apply-sql.mjs supabase/migrations/006_admin_kick_member.sql",
		"db:apply-admin-delete-league": "node scripts/apply-sql.mjs supabase/migrations/025_admin_delete_league.sql",
		"db:apply-public-demo-league": "node scripts/apply-sql.mjs supabase/migrations/026_public_demo_league.sql",
		"db:apply-fix-qa-auto-mnf": "node scripts/apply-sql.mjs supabase/migrations/027_fix_qa_auto_mnf_rls.sql",
		"db:apply-e2e-admin": "node scripts/apply-sql.mjs supabase/migrations/028_e2e_admin_user.sql",
		"db:apply-lock-public-demo": "node scripts/apply-sql.mjs supabase/migrations/029_lock_public_demo_membership.sql",
		"db:apply-anon-public-demo": "node scripts/apply-sql.mjs supabase/migrations/030_anon_public_demo.sql",
		"db:apply-get-viewable-league": "node scripts/apply-sql.mjs supabase/migrations/031_get_viewable_league.sql",
		"db:apply-admin-directory": "node scripts/apply-sql.mjs supabase/migrations/032_admin_directory.sql",
		"db:generate-games": "node --import tsx/esm scripts/generate-games-migration.mjs",
		"test:e2e": "playwright test --config=e2e/playwright.config.ts",
		"test:e2e:ui": "playwright test --config=e2e/playwright.config.ts --ui",
		"sync:copy-functions": "rm -rf supabase/functions/_shared/sync && mkdir -p supabase/functions/_shared && cp -R src/lib/sync supabase/functions/_shared/sync",
		"sync:nfl": "node --import tsx/esm scripts/sync-nfl-data.mjs",
		"functions:deploy": "npm run sync:copy-functions && npx supabase functions deploy sync-nfl-data"
	},
	"devDependencies": {
		"@playwright/test": "^1.62.1",
		"@sveltejs/adapter-auto": "^7.0.1",
		"@sveltejs/adapter-static": "^3.0.10",
		"@sveltejs/kit": "^2.57.0",
		"@sveltejs/vite-plugin-svelte": "^7.0.0",
		"dotenv": "^17.4.2",
		"pg": "^8.16.0",
		"svelte": "^5.55.2",
		"svelte-check": "^4.4.6",
		"tsx": "^4.20.3",
		"typescript": "^6.0.2",
		"vite": "^8.0.7"
	},
	"dependencies": {
		"@supabase/supabase-js": "^2.106.2"
	}
}
